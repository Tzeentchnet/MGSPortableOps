function(mgspo_read_generated_sources gen_dir output_var)
  set(manifest "${gen_dir}/mgspo_generated_sources.txt")
  if(NOT EXISTS "${manifest}")
    message(FATAL_ERROR
      "No generated source manifest in ${gen_dir}. "
      "Run tools/mgspo/gen.py first.")
  endif()
  file(STRINGS "${manifest}" relative_sources)
  set(sources)
  set(chunk_found FALSE)
  set(register_found FALSE)
  set(native_chunk_stems)
  set(native_register_stems)
  foreach(relative_source IN LISTS relative_sources)
    if(relative_source MATCHES "^mgspo_recomp_[0-9][0-9][0-9]\\.c$")
      set(chunk_found TRUE)
    elseif(relative_source STREQUAL "mgspo_recomp_register.c")
      set(register_found TRUE)
    elseif(relative_source MATCHES
        "^(native/[a-z0-9_-]+/[a-z0-9_]+_recomp)_[0-9][0-9][0-9]\\.c$")
      list(APPEND native_chunk_stems "${CMAKE_MATCH_1}")
    elseif(relative_source MATCHES
        "^(native/[a-z0-9_-]+/[a-z0-9_]+_recomp)_register\\.c$")
      list(APPEND native_register_stems "${CMAKE_MATCH_1}")
    else()
      message(FATAL_ERROR
        "Invalid generated source manifest entry: ${relative_source}")
    endif()
    if(NOT EXISTS "${gen_dir}/${relative_source}")
      message(FATAL_ERROR
        "Missing generated source: ${gen_dir}/${relative_source}")
    endif()
    set(source "${gen_dir}/${relative_source}")
    if(source IN_LIST sources)
      message(FATAL_ERROR "Duplicate generated source: ${relative_source}")
    endif()
    list(APPEND sources "${source}")
  endforeach()
  if(NOT chunk_found OR NOT register_found)
    message(FATAL_ERROR
      "Generated source manifest is incomplete. Run tools/mgspo/gen.py again.")
  endif()
  list(REMOVE_DUPLICATES native_chunk_stems)
  list(REMOVE_DUPLICATES native_register_stems)
  list(SORT native_chunk_stems)
  list(SORT native_register_stems)
  if(NOT native_chunk_stems STREQUAL native_register_stems)
    message(FATAL_ERROR
      "Generated native-module manifest is incomplete. "
      "Run tools/mgspo/gen.py again.")
  endif()
  set(${output_var} "${sources}" PARENT_SCOPE)
endfunction()
