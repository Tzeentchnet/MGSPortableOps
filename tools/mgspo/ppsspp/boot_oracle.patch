+	case 28:
+	case 31:
+	case 33:
+	case 35:
+	case 38:
+	case 42:
+	case 46:
+	case 48:
+	case 50:
+	case 52:
+	case 54:
+		return true;
+	default:
+		return false;
+	}
+}
