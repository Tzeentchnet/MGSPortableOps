+void WriteKJFSPointerEvidence(FILE *stream, int argument, u32 address) {
+	if (!Memory::IsValidRange(address, 64))
+		return;
+	const u8 *data = Memory::GetPointerRange(address, 64);
+	std::fprintf(stream, ",\"arg%d_hex\":\"", argument);
+	for (int index = 0; index < 64; ++index)
+		std::fprintf(stream, "%02x", data[index]);
+	std::fputc('"', stream);
+
+	std::string text;
+	for (int index = 0; index < 256; ++index) {
+		u32 current = address + index;
+		if (!Memory::IsValidAddress(current)) {
+			text.clear();
+			break;
+		}
+		u8 value = *Memory::GetPointerUnchecked(current);
+		if (!value) {
+			if (!text.empty()) {
+				std::fprintf(stream, ",\"arg%d_text\":", argument);
+				WriteJSONString(stream, text.c_str());
+			}
+			break;
+		}
+		if (value < 0x20 || value > 0x7E) {
+			text.clear();
+			break;
+		}
+		text.push_back((char)value);
+	}
+}
+
+void WriteKJFSEvidence(
+	const char *event,
+	const MIPSState *mips,
+	const KJFSCall &call,
+	u32 pc) {
+	std::fprintf(
+		state.events,
+		"{\"event\":\"%s\",\"step\":%llu,\"thread\":%d,\"nid\":%u,"
+		"\"pc\":%u,\"return_pc\":%u,\"args\":[%u,%u,%u,%u]",
+		event,
+		state.step,
+		call.thread,
+		call.nid,
+		pc,
+		call.returnPC,
+		call.args[0],
+		call.args[1],
+		call.args[2],
+		call.args[3]);
+	if (std::strcmp(event, "kjfs_return") == 0) {
+		std::fprintf(
+			state.events,
+			",\"result\":%u,\"result_hi\":%u",
+			mips->r[MIPS_REG_V0],
+			mips->r[MIPS_REG_V1]);
+	} else {
+		u32 sp = mips->r[MIPS_REG_SP];
+		if (Memory::IsValidRange(sp + 16, 32)) {
+			std::fputs(",\"stack\":[", state.events);
+			for (int index = 0; index < 8; ++index) {
+				if (index)
+					std::fputc(',', state.events);
+				std::fprintf(
+					state.events,
+					"%u",
+					Memory::Read_U32(sp + 16 + index * 4));
+			}
+			std::fputc(']', state.events);
+		}
+	}
+	for (int index = 0; index < 4; ++index)
+		WriteKJFSPointerEvidence(state.events, index, call.args[index]);
+	std::fputs("}\n", state.events);
+}
