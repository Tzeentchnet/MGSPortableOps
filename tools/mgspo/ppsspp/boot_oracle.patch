+}
+
+void StartKJFSProbe() {
+	state.kjfsProbeStartPending = false;
+	u32 size = 0x10000;
+	u32 scratch = userMemory.Alloc(size, true, "KJFS oracle probe");
+	if (scratch == 0xFFFFFFFF)
+		OracleFatal("cannot allocate KJFS probe memory");
+	state.kjfsProbeScratch = scratch;
+	state.kjfsProbeHandle = 0;
+	state.kjfsProbeCanonicalFileSize = 0;
+	state.kjfsProbeStage = ParseKJFSProbeStage(
+		"PSPRECOMP_ORACLE_KJFS_PROBE_STAGE",
+		0,
+		KJFS_PROBE_STAGE_COUNT - 1);
+	state.kjfsProbeInitialStage = state.kjfsProbeStage;
+	state.kjfsProbeStopStage = ParseKJFSProbeStage(
+		"PSPRECOMP_ORACLE_KJFS_PROBE_STOP",
+		KJFS_PROBE_STAGE_COUNT,
+		KJFS_PROBE_STAGE_COUNT);
+	if (state.kjfsProbeStage >= state.kjfsProbeStopStage)
+		OracleFatal("KJFS probe start stage must precede its stop stage");
+	const char *blockedStage =
+		std::getenv("PSPRECOMP_ORACLE_KJFS_BLOCK_STAGE");
+	const char *blockedRetries =
+		std::getenv("PSPRECOMP_ORACLE_KJFS_BLOCK_RETRIES");
+	if ((blockedStage == nullptr) != (blockedRetries == nullptr))
+		OracleFatal("KJFS blocked probe configuration is incomplete");
+	state.kjfsProbeBlockedEnabled = blockedStage != nullptr;
+	if (state.kjfsProbeBlockedEnabled) {
+		state.kjfsProbeBlockedStage = ParseKJFSProbeStage(
+			"PSPRECOMP_ORACLE_KJFS_BLOCK_STAGE",
+			0,
+			KJFS_PROBE_STAGE_COUNT - 1);
+		state.kjfsProbeBlockedRetryLimit = ParseKJFSProbeStage(
+			"PSPRECOMP_ORACLE_KJFS_BLOCK_RETRIES",
+			0,
+			64);
+		const KJFSBlockedSpec *spec =
+			KJFSBlockedSpecForStage(state.kjfsProbeBlockedStage);
+		const int expectedStart =
+			state.kjfsProbeBlockedStage == 43
+			? 42
+			: state.kjfsProbeBlockedStage;
+		if (!spec || state.kjfsProbeBlockedRetryLimit < 1 ||
+			state.kjfsProbeStage != expectedStart ||
+			state.kjfsProbeStopStage !=
+				state.kjfsProbeBlockedStage + 1) {
+			OracleFatal("KJFS blocked probe range is invalid");
+		}
+	}
+	state.kjfsProbeBlockedRetryCount = 0;
+	state.kjfsProbeBlockedPhase = 0;
+	state.kjfsProbeBlockedThread = 0;
+	state.kjfsProbeBlockedAsyncResultAddress = 0;
+	state.kjfsProbeRunning = true;
+	std::memset(Memory::GetPointerWriteUnchecked(scratch), 0xCC, size);
+	SetKJFSProbeString(
+		scratch + 0x0000,
+		"disc0:/PSP_GAME/USRDIR/stage/init/data.cnf");
+	SetKJFSProbeString(
+		scratch + 0x0100,
+		"DISC0:/PSP_GAME/USRDIR/stage/init/data.cnf");
+	SetKJFSProbeString(
+		scratch + 0x0200,
+		"disc0:\\PSP_GAME\\USRDIR\\stage\\init\\data.cnf");
+	SetKJFSProbeString(
+		scratch + 0x0300,
+		"disc0:/psp_game/usrdir/STAGE/INIT/DATA.CNF");
+	SetKJFSProbeString(
+		scratch + 0x0400,
+		"disc0:/PSP_GAME/USRDIR/stage/./init/../init/data.cnf");
+	SetKJFSProbeString(
+		scratch + 0x0500,
+		"disc0:/PSP_GAME//USRDIR///stage/init/data.cnf");
+	SetKJFSProbeString(
+		scratch + 0x0600,
+		"disc0:/PSP_GAME/USRDIR/stage/init/__mgspo_missing__.bin");
+	SetKJFSProbeString(scratch + 0x0700, "disc0:/UMD_DATA.BIN");
+	SetKJFSProbeString(scratch + 0x0800, "disc0:/umd_data.bin");
+	SetKJFSProbeString(scratch + 0x0900, "disc0:/./UMD_DATA.BIN");
+	SetKJFSProbeString(scratch + 0x0A00, "disc0://UMD_DATA.BIN");
+	std::fprintf(
+		state.events,
+		"{\"event\":\"kjfs_probe_start\",\"step\":%llu,"
+		"\"scratch\":%u,\"start_stage\":%d,\"stop_stage\":%d}\n",
+		state.step,
+		scratch,
+		state.kjfsProbeStage,
+		state.kjfsProbeStopStage);
+	state.kjfsProbeCallPending = true;
+}
+
+void CompleteKJFSProbe() {
+	if (std::fflush(state.trace) != 0 || std::fflush(state.events) != 0)
+		OracleFatal("cannot flush KJFS probe output");
+	FILE *trace = state.trace;
+	state.trace = nullptr;
+	if (std::fclose(trace) != 0)
+		OracleFatal("cannot close KJFS probe trace");
+	FILE *events = state.events;
+	state.events = nullptr;
+	if (std::fclose(events) != 0)
+		OracleFatal("cannot close KJFS probe events");
+
+	const std::string donePath = OutputPath("service.done");
+	FILE *done = std::fopen(donePath.c_str(), "wb");
+	if (!done)
+		OracleFatal("cannot create KJFS probe completion marker");
+	if (std::fprintf(
+			done,
+			"{\"schema\":1,\"steps\":%llu,\"start_stage\":%d,"
+			"\"stop_stage\":%d,\"case_count\":%d}\n",
+			state.step,
+			state.kjfsProbeInitialStage,
+			state.kjfsProbeStopStage,
+			state.kjfsProbeStopStage - state.kjfsProbeInitialStage) < 0 ||
+		std::fclose(done) != 0)
+		OracleFatal("cannot write KJFS probe completion marker");
+	state.active = false;
+	Core_Stop();
+}
+
+void CompleteKJFSBlockedProbe() {
+	const KJFSBlockedSpec *spec =
+		KJFSBlockedSpecForStage(state.kjfsProbeBlockedStage);
+	if (!spec)
+		OracleFatal("KJFS blocked probe specification is unavailable");
+	std::fprintf(
+		state.events,
+		"{\"event\":\"kjfs_probe_blocked\",\"stage\":%d,\"case\":",
+		spec->stage);
+	WriteJSONString(state.events, KJFS_PROBE_LABELS[spec->stage]);
+	std::fprintf(
+		state.events,
+		",\"retry_count\":%d,\"operation\":{\"name\":",
+		state.kjfsProbeBlockedRetryCount);
+	WriteJSONString(state.events, spec->operationName);
+	std::fprintf(
+		state.events,
+		",\"nid\":%u,\"pc\":%u,\"result\":%u}",
+		spec->operationNID,
+		spec->operationPC,
+		spec->operationResult);
+	if (spec->waitName) {
+		std::fputs(",\"wait\":{\"name\":", state.events);
+		WriteJSONString(state.events, spec->waitName);
+		std::fprintf(
+			state.events,
+			",\"nid\":%u,\"pc\":%u,\"result\":%u,"
+			"\"async_result_low\":%u,\"async_result_high\":%u}",
+			spec->waitNID,
+			spec->waitPC,
+			spec->waitResult,
+			spec->asyncResultLow,
+			spec->asyncResultHigh);
+	}
+	std::fprintf(
+		state.events,
+		",\"thread_consistent\":true,"
+		"\"delay\":{\"name\":\"sceKernelDelayThreadCB\","
+		"\"nid\":%u,\"pc\":%u,\"microseconds\":1000000,"
+		"\"result\":0}}\n",
+		0x68DA9E36,
+		spec->delayPC);
+
+	if (std::fflush(state.trace) != 0 || std::fflush(state.events) != 0)
+		OracleFatal("cannot flush KJFS blocked probe output");
+	FILE *trace = state.trace;
+	state.trace = nullptr;
+	if (std::fclose(trace) != 0)
+		OracleFatal("cannot close KJFS blocked probe trace");
+	FILE *events = state.events;
+	state.events = nullptr;
+	if (std::fclose(events) != 0)
+		OracleFatal("cannot close KJFS blocked probe events");
+
+	const std::string donePath = OutputPath("service.blocked");
+	FILE *done = std::fopen(donePath.c_str(), "wb");
+	if (!done)
+		OracleFatal("cannot create KJFS blocked probe marker");
+	bool doneOK = std::fprintf(
+			done,
+			"{\"schema\":1,\"stage\":%d,\"case\":\"%s\","
+			"\"retry_count\":%d}\n",
+			spec->stage,
+			KJFS_PROBE_LABELS[spec->stage],
+			state.kjfsProbeBlockedRetryCount) >= 0;
+	if (std::fclose(done) != 0)
+		doneOK = false;
+	if (!doneOK) {
+		OracleFatal("cannot write KJFS blocked probe marker");
+	}
+	state.kjfsProbeRunning = false;
+	state.active = false;
+	Core_Stop();
+}
+
+void StartKJFSProbeCall() {
+	state.kjfsProbeCallPending = false;
+	int stage = state.kjfsProbeStage;
+	if (stage == state.kjfsProbeStopStage) {
+		std::fprintf(
+			state.events,
+			"{\"event\":\"kjfs_probe_done\",\"step\":%llu}\n",
+			state.step);
+		state.kjfsProbeRunning = false;
+		CompleteKJFSProbe();
+		return;
+	}
+
+	u32 args[6]{};
+	int numArgs = 0;
+	u32 entry = 0;
+	u32 scratch = state.kjfsProbeScratch;
+	u32 handle = state.kjfsProbeHandle;
+	state.kjfsProbeBuffer = 0;
+	switch (stage) {
+	case 0:
+	case 4:
+	case 20:
+	case 22:
+	case 24:
+	case 26:
+	case 28:
+	case 30:
+	case 31:
+	case 33:
+	case 35:
+	case 38:
+	case 42:
+	case 46:
+	case 48:
+	case 50:
+	case 52:
+	case 54: {
+		static const u32 pathOffsets[] = {
+			0x0000, 0x0100, 0x0200, 0x0300, 0x0400, 0x0500, 0x0600,
+		};
+		int pathIndex = 0;
+		if (stage >= 20 && stage <= 30)
+			pathIndex = 1 + (stage - 20) / 2;
+		u32 pathOffset =
+			stage == 54 ? 0 :
+			stage >= 48 ? 0x0800 + (stage - 48) * 0x80 :
+			stage == 4 || stage == 42 || stage == 46
+			? 0x0700 : pathOffsets[pathIndex];
+		args[0] = scratch + pathOffset;
+		args[1] = stage == 31 ? 0 : stage == 33 ? 2 : 1;
+		args[2] = 0;
+		args[3] = scratch + 0x2000;
+		numArgs = 4;
+		entry = 0x08B762D8;
+		break;
+	}
+	case 1:
+	case 5:
+	case 17:
+	case 55:
+		args[0] = handle;
+		numArgs = 1;
+		entry = 0x08B77900;
+		break;
+	case 2:
+	case 7:
+	case 9:
+	case 11:
+	case 12:
+	case 14:
+	case 18:
+	case 36:
+	case 39:
+	case 40:
+	case 56:
+		state.kjfsProbeBuffer = scratch + 0x1000;
+		std::memset(
+			Memory::GetPointerWriteUnchecked(state.kjfsProbeBuffer - 16),
+			0xCC,
+			96);
+		args[0] = stage == 18 ? 0x7FFFFFFF : handle;
+		args[1] = stage == 36 ? 0 : state.kjfsProbeBuffer;
+		if (stage == 36)
+			state.kjfsProbeBuffer = 0;
+		switch (stage) {
+		case 2: args[2] = 8; break;
+		case 7: args[2] = 8; break;
+		case 9: args[2] = 4; break;
+		case 11: args[2] = 8; break;
+		case 12: args[2] = 4; break;
+		case 14: args[2] = 4; break;
+		case 18: args[2] = 4; break;
+		case 36: args[2] = 4; break;
+		case 39: args[2] = 0; break;
+		case 40: args[2] = 64; break;
+		case 56:
+			if (!state.kjfsProbeCanonicalFileSize ||
+				state.kjfsProbeCanonicalFileSize > 64)
+				OracleFatal("KJFS probe canonical file size is unavailable");
+			args[2] = state.kjfsProbeCanonicalFileSize;
+			break;
+		}
+		numArgs = 3;
+		entry = 0x08B76778;
+		break;
+	case 6:
+	case 8:
+	case 10:
+	case 13:
+	case 15:
+	case 43:
+	case 45:
+	case 47:
+		args[0] = stage == 45 ? 0x7FFFFFFF : handle;
+		args[1] = 0;
+		switch (stage) {
+		case 6: args[2] = 0; args[3] = 0; args[4] = 0; break;
+		case 8: args[2] = 10; args[3] = 0; args[4] = 0; break;
+		case 10:
+			args[2] = 0xFFFFFFFC;
+			args[3] = 0xFFFFFFFF;
+			args[4] = 2;
+			break;
+		case 13: args[2] = 49; args[3] = 0; args[4] = 0; break;
+		case 15: args[2] = 2; args[3] = 0; args[4] = 1; break;
+		case 43:
+			args[2] = 0xFFFFFFFF;
+			args[3] = 0xFFFFFFFF;
+			args[4] = 0;
+			break;
+		case 45: args[2] = 0; args[3] = 0; args[4] = 0; break;
+		case 47: args[2] = 0; args[3] = 0; args[4] = 3; break;
+		}
+		numArgs = 5;
+		entry = 0x08B76338;
+		break;
+	case 3:
+	case 16:
+	case 21:
+	case 23:
+	case 25:
+	case 27:
+	case 29:
+	case 32:
+	case 34:
+	case 37:
+	case 41:
+	case 44:
+	case 49:
+	case 51:
+	case 53:
+	case 57:
+		args[0] = handle;
+		numArgs = 1;
+		entry = 0x08B76C18;
+		break;
+	case 19:
+		args[0] = 0x7FFFFFFF;
+		numArgs = 1;
+		entry = 0x08B76C18;
+		break;
+	default:
+		OracleFatal("invalid KJFS probe stage");
+	}
+
+	std::fprintf(
+		state.events,
+		"{\"event\":\"kjfs_probe_case\",\"phase\":\"call\","
+		"\"stage\":%d,\"case\":",
+		stage);
+	WriteJSONString(state.events, KJFS_PROBE_LABELS[stage]);
+	std::fputs(",\"args\":[", state.events);
+	for (int index = 0; index < numArgs; ++index) {
+		if (index)
+			std::fputc(',', state.events);
+		std::fprintf(state.events, "%u", args[index]);
+	}
+	std::fputc(']', state.events);
+	if (entry == 0x08B762D8)
+		WriteKJFSProbePath(state.events, args[0]);
+	std::fputs("}\n", state.events);
+	if (numArgs > 4) {
+		state.kjfsProbeExtraPending = true;
+		state.kjfsProbeThread = __KernelGetCurThread();
+		state.kjfsProbeExtraEntry = entry;
+		state.kjfsProbeExtraValue = args[4];
+	}
+	__KernelDirectMipsCall(
+		entry,
+		new KJFSProbeAction(stage),
+		args,
+		numArgs,
+		false);
+}
+
+void ObserveKJFS(MIPSState *mips, u32 pc) {
+	int thread = __KernelGetCurThread();
+	for (size_t index = state.kjfsCallCount; index > 0; --index) {
+		KJFSCall &call = state.kjfsCalls[index - 1];
+		if (call.thread == thread && call.returnPC == pc) {
+			WriteKJFSEvidence("kjfs_return", mips, call, pc);
+			if (state.kjfsProbeEnabled &&
+				call.nid == 0xC5183ABB &&
+				!state.kjfsProbeRunning) {
+				state.kjfsProbeStartPending = true;
+			}
+			for (size_t move = index; move < state.kjfsCallCount; ++move)
+				state.kjfsCalls[move - 1] = state.kjfsCalls[move];
+			--state.kjfsCallCount;
+			break;
+		}
+	}
+
+	u32 nid = KJFSNID(pc);
+	if (!nid || !KJFSIdentityActive())
+		return;
+	if (state.kjfsProbeExtraPending &&
+		pc == state.kjfsProbeExtraEntry &&
+		thread == state.kjfsProbeThread &&
+		mips->r[MIPS_REG_RA] == 0x08000018) {
+		if (mips->r[MIPS_REG_T0] != state.kjfsProbeExtraValue)
+			OracleFatal("KJFS probe fifth argument is not in t0");
+		state.kjfsProbeExtraPending = false;
+	}
+	if (state.kjfsCallCount == MAX_KJFS_CALLS)
+		OracleFatal("KJFS call stack overflow");
+	KJFSCall &call = state.kjfsCalls[state.kjfsCallCount++];
+	call.thread = thread;
+	call.nid = nid;
+	call.returnPC = mips->r[MIPS_REG_RA];
+	for (int index = 0; index < 4; ++index)
+		call.args[index] = mips->r[MIPS_REG_A0 + index];
+	WriteKJFSEvidence("kjfs_call", mips, call, pc);
+}
+
+void ObserveKJFSBlockedSyscallReturn(
+	const char *name,
+	u32 nid,
+	u32 pc,
+	int thread,
+	const u32 arguments[4],
+	u32 result) {
+	if (!state.active ||
+		!state.kjfsProbeRunning ||
+		!state.kjfsProbeBlockedEnabled ||
+		state.kjfsProbeStage != state.kjfsProbeBlockedStage) {
+		return;
+	}
+	const KJFSBlockedSpec *spec =
+		KJFSBlockedSpecForStage(state.kjfsProbeBlockedStage);
+	if (!spec)
+		OracleFatal("KJFS blocked probe specification is unavailable");
+
+	if (nid == spec->operationNID && pc == spec->operationPC) {
+		if (state.kjfsProbeBlockedPhase != 0)
+			OracleFatal("KJFS blocked operation repeated out of order");
+		if (!name || std::strcmp(name, spec->operationName) != 0 ||
+			result != spec->operationResult) {
+			OracleFatal("KJFS blocked operation result mismatch");
+		}
+		if (!state.kjfsProbeBlockedThread)
+			state.kjfsProbeBlockedThread = thread;
+		if (thread != state.kjfsProbeBlockedThread)
+			OracleFatal("KJFS blocked operation changed threads");
+		state.kjfsProbeBlockedPhase = spec->waitName ? 1 : 2;
+		return;
+	}
+
+	if (spec->waitName && nid == spec->waitNID && pc == spec->waitPC) {
+		if (state.kjfsProbeBlockedPhase != 1 ||
+			thread != state.kjfsProbeBlockedThread ||
+			!name || std::strcmp(name, spec->waitName) != 0 ||
+			result != spec->waitResult) {
+			OracleFatal("KJFS blocked wait result mismatch");
+		}
+		const u32 address = arguments[1];
+		if (!Memory::IsValidRange(address, 8))
+			OracleFatal("KJFS blocked wait async result address is invalid");
+		state.kjfsProbeBlockedAsyncResultAddress = address;
+		state.kjfsProbeBlockedPhase = 2;
+		return;
+	}
+
+	if (nid == 0x68DA9E36 && pc == spec->delayPC) {
+		if (state.kjfsProbeBlockedPhase != 2 ||
+			thread != state.kjfsProbeBlockedThread ||
+			!name || std::strcmp(name, "sceKernelDelayThreadCB") != 0 ||
+			arguments[0] != 1000000 ||
+			result != 0) {
+			OracleFatal("KJFS blocked delay result mismatch");
+		}
+		if (spec->waitName) {
+			const u32 address =
+				state.kjfsProbeBlockedAsyncResultAddress;
+			if (!Memory::IsValidRange(address, 8) ||
+				Memory::Read_U32(address) != spec->asyncResultLow ||
+				Memory::Read_U32(address + 4) !=
+					spec->asyncResultHigh) {
+				OracleFatal("KJFS blocked wait async result mismatch");
+			}
+			state.kjfsProbeBlockedAsyncResultAddress = 0;
+		}
+		state.kjfsProbeBlockedPhase = 0;
+		++state.kjfsProbeBlockedRetryCount;
+		if (state.kjfsProbeBlockedRetryCount ==
+			state.kjfsProbeBlockedRetryLimit) {
+			CompleteKJFSBlockedProbe();
+		}
+	}
+}
+
+}  // namespace
+
+void PSPRecompOracleBeginStep(MIPSState *mips, u32 pc, u32 op) {
+	Configure();
+	state.stepActive = false;
+	if (!state.enabled)
+		return;
+	if (!state.active) {
+		if (pc != state.startPC)
+			return;
+		state.active = true;
+		OpenTrace(mips);
+	}
+	if (state.kjfsEventsEnabled)
+		ObserveKJFS(mips, pc);
+	if (state.eventsOnly) {
+		state.pc = pc;
+		state.op = op;
+		state.memAddress = 0;
+		state.memSize = 0;
+	} else {
+		Snapshot(mips, pc, op);
+	}
+	state.stepActive = true;
+}
+
+void PSPRecompOracleEndStep(MIPSState *mips) {
+	if (!state.stepActive)
+		return;
+	state.stepActive = false;
+	if (!state.eventsOnly)
+		WriteStep(mips);
+	++state.step;
+	if (state.step == state.limit) {
+		if (state.eventsOnly && state.kjfsProbeEnabled)
+			OracleFatal("KJFS probe exceeded its instruction limit");
+		Complete();
+		return;
+	}
+	if (state.kjfsProbeStartPending)
+		StartKJFSProbe();
+	if (state.kjfsProbeCallPending)
+		StartKJFSProbeCall();
+}
+
+void PSPRecompOracleSyscall(
+	std::string_view module,
+	const char *name,
+	u32 nid,
+	u32 pc,
+	u32 op,
+	int thread) {
+	if (!state.active || !state.events)
+		return;
+	std::fputs("{\"event\":\"syscall\",\"step\":", state.events);
+	std::fprintf(
+		state.events,
+		"%llu,\"thread\":%d,\"pc\":%u,\"op\":%u,\"module\":",
+		state.step,
+		thread,
+		pc,
+		op);
+	const std::string moduleString(module);
+	WriteJSONString(state.events, moduleString.c_str());
+	std::fputs(",\"name\":", state.events);
+	WriteJSONString(state.events, name ? name : "");
+	std::fprintf(state.events, ",\"nid\":%u}\n", nid);
+}
+
+void PSPRecompOracleSyscallReturn(
+	const char *name,
+	u32 nid,
+	u32 pc,
+	int thread,
+	const u32 arguments[4],
+	u32 result) {
+	ObserveKJFSBlockedSyscallReturn(
+		name, nid, pc, thread, arguments, result);
+}
+
+void PSPRecompOracleThreadSwitch(
+	int from,
+	int to,
+	u32 fromPC,
+	u32 toPC,
+	const char *reason) {
+	if (!state.active || !state.events)
+		return;
+	std::fprintf(
+		state.events,
+		"{\"event\":\"thread_switch\",\"step\":%llu,\"from\":%d,"
+		"\"to\":%d,\"from_pc\":%u,\"to_pc\":%u,\"reason\":",
+		state.step,
+		from,
+		to,
+		fromPC,
+		toPC);
+	WriteJSONString(state.events, reason ? reason : "");
+	std::fputs("}\n", state.events);
+}
