+class KJFSProbeAction : public PSPAction {
+public:
+	explicit KJFSProbeAction(int stage) : stage_(stage) {
+		actionTypeID = -1;
+	}
+
+	void run(MipsCall &) override {
+		if (state.kjfsProbeBlockedEnabled &&
+			stage_ == state.kjfsProbeBlockedStage) {
+			OracleFatal("KJFS blocked probe call unexpectedly returned");
+		}
+		u32 result = currentMIPS->r[MIPS_REG_V0];
+		u32 resultHi = currentMIPS->r[MIPS_REG_V1];
+		std::fprintf(
+			state.events,
+			"{\"event\":\"kjfs_probe_case\",\"phase\":\"return\","
+			"\"stage\":%d,\"case\":",
+			stage_);
+		WriteJSONString(state.events, KJFS_PROBE_LABELS[stage_]);
+		std::fprintf(
+			state.events,
+			",\"result\":%u,\"result_hi\":%u",
+			result,
+			resultHi);
+		WriteKJFSProbeBuffer(state.events, state.kjfsProbeBuffer);
+		std::fputs("}\n", state.events);
+		if (KJFSProbeStageOpensHandle(stage_))
+			state.kjfsProbeHandle = result;
+		if (stage_ == 55) {
+			if (!result || result > 64)
+				OracleFatal("KJFS probe canonical file size is invalid");
+			state.kjfsProbeCanonicalFileSize = result;
+		}
+		if (state.kjfsProbeExtraPending)
+			OracleFatal("KJFS probe did not verify its fifth argument");
+		state.kjfsProbeStage = stage_ + 1;
+		state.kjfsProbeCallPending = true;
+	}
+
+	void DoState(PointerWrap &) override {
+	}
+
+private:
+	int stage_;
+};
