+
+int ParseKJFSProbeStage(const char *name, int defaultValue, int maximum) {
+	const char *text = std::getenv(name);
+	if (!text || !text[0])
+		return defaultValue;
+	char *end = nullptr;
+	errno = 0;
+	long value = std::strtol(text, &end, 10);
+	if (errno || end == text || *end || value < 0 || value > maximum) {
+		std::fprintf(stderr, "PSP recomp oracle: invalid %s: %s\n", name, text);
+		std::exit(2);
+	}
+	return (int)value;
+}
