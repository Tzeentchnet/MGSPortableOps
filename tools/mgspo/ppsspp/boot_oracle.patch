+void WriteKJFSProbeBuffer(FILE *stream, u32 address) {
+	if (!address)
+		return;
+	if (address < 16 || !Memory::IsValidRange(address - 16, 96))
+		OracleFatal("KJFS probe buffer guard is outside guest memory");
+	const u8 *data = Memory::GetPointerRange(address, 64);
+	std::fputs(",\"buffer_hex\":\"", stream);
+	for (int index = 0; index < 64; ++index)
+		std::fprintf(stream, "%02x", data[index]);
+	std::fputc('"', stream);
+	const u8 *before = Memory::GetPointerRange(address - 16, 16);
+	const u8 *after = Memory::GetPointerRange(address + 64, 16);
+	std::fputs(",\"guard_before_hex\":\"", stream);
+	for (int index = 0; index < 16; ++index)
+		std::fprintf(stream, "%02x", before[index]);
+	std::fputs("\",\"guard_after_hex\":\"", stream);
+	for (int index = 0; index < 16; ++index)
+		std::fprintf(stream, "%02x", after[index]);
+	std::fputc('"', stream);
+}
+
+void WriteKJFSProbePath(FILE *stream, u32 address) {
+	if (!Memory::IsValidRange(address, 256))
+		OracleFatal("KJFS probe path is outside guest memory");
+	const u8 *path = Memory::GetPointerRange(address, 256);
+	const u8 *end = static_cast<const u8 *>(std::memchr(path, 0, 256));
+	if (!end)
+		OracleFatal("KJFS probe path is not terminated");
+	std::fputs(",\"path_hex\":\"", stream);
+	for (const u8 *cursor = path; cursor < end; ++cursor)
+		std::fprintf(stream, "%02x", *cursor);
+	std::fputc('"', stream);
+}
