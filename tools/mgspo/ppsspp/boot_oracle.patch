+constexpr unsigned long long MAX_TRACE_STEPS = 50000000ULL;
+constexpr size_t MAX_KJFS_CALLS = 64;
+
+struct KJFSCall {
+	int thread = 0;
+	u32 nid = 0;
+	u32 returnPC = 0;
+	u32 args[4]{};
+};
+
+struct OracleState {
+	bool configured = false;
+	bool enabled = false;
+	bool active = false;
+	bool stepActive = false;
+	bool eventsOnly = false;
+	u32 startPC = 0;
+	unsigned long long limit = 0;
+	unsigned long long step = 0;
+	u32 pc = 0;
+	u32 op = 0;
+	u32 memAddress = 0;
+	int memSize = 0;
+	u32 r[32]{};
+	u32 fi[32]{};
+	u32 vi[128]{};
+	u32 hi = 0;
+	u32 lo = 0;
+	u32 fcr31 = 0;
+	std::string directory;
+	std::string target;
+	FILE *trace = nullptr;
+	FILE *events = nullptr;
+	KJFSCall kjfsCalls[MAX_KJFS_CALLS]{};
+	size_t kjfsCallCount = 0;
+	bool kjfsEventsEnabled = false;
+	bool kjfsProbeEnabled = false;
+	bool kjfsProbeStartPending = false;
+	bool kjfsProbeCallPending = false;
+	bool kjfsProbeRunning = false;
+	int kjfsProbeInitialStage = 0;
+	int kjfsProbeStage = 0;
+	int kjfsProbeStopStage = 0;
+	u32 kjfsProbeScratch = 0;
+	u32 kjfsProbeHandle = 0;
+	u32 kjfsProbeCanonicalFileSize = 0;
+	u32 kjfsProbeBuffer = 0;
+	bool kjfsProbeExtraPending = false;
+	int kjfsProbeThread = 0;
+	u32 kjfsProbeExtraEntry = 0;
+	u32 kjfsProbeExtraValue = 0;
+	bool kjfsProbeBlockedEnabled = false;
+	int kjfsProbeBlockedStage = 0;
+	int kjfsProbeBlockedRetryLimit = 0;
+	int kjfsProbeBlockedRetryCount = 0;
+	int kjfsProbeBlockedPhase = 0;
+	int kjfsProbeBlockedThread = 0;
+	u32 kjfsProbeBlockedAsyncResultAddress = 0;
+};
+
+OracleState state;
+
+[[noreturn]] void OracleFatal(const char *message) {
+	std::fprintf(stderr, "PSP recomp oracle: %s\n", message);
+	if (state.trace)
+		std::fclose(state.trace);
+	if (state.events)
+		std::fclose(state.events);
+	std::exit(2);
+}
+
+std::string OutputPath(const char *name) {
+	return state.directory + "/" + name;
+}
+
+u32 ParseHex(const char *value, const char *name) {
+	char *end = nullptr;
+	errno = 0;
+	unsigned long parsed = std::strtoul(value, &end, 16);
+	if (errno || end == value || *end != '\0' || parsed > 0xFFFFFFFFUL) {
+		std::fprintf(stderr, "PSP recomp oracle: invalid %s: %s\n", name, value);
+		std::exit(2);
+	}
+	return (u32)parsed;
+}
+
+unsigned long long ParseSteps(const char *value) {
+	char *end = nullptr;
+	errno = 0;
+	unsigned long long parsed = std::strtoull(value, &end, 10);
+	if (errno || end == value || *end != '\0' || parsed == 0 || parsed > MAX_TRACE_STEPS) {
+		std::fprintf(stderr, "PSP recomp oracle: invalid step limit: %s\n", value);
+		std::exit(2);
+	}
+	return parsed;
+}
+
+void Configure() {
+	if (state.configured)
+		return;
+	state.configured = true;
+	const char *directory = std::getenv("PSPRECOMP_ORACLE_DIR");
+	if (!directory || !directory[0])
+		return;
+	const char *startPC = std::getenv("PSPRECOMP_ORACLE_START_PC");
+	const char *steps = std::getenv("PSPRECOMP_ORACLE_STEPS");
+	const char *target = std::getenv("PSPRECOMP_ORACLE_TARGET");
+	if (!startPC || !steps || !target || !target[0])
+		OracleFatal("DIR requires START_PC, STEPS, and TARGET");
+	state.startPC = ParseHex(startPC, "start PC");
+	if ((state.startPC & 3) != 0)
+		OracleFatal("start PC must be four-byte aligned");
+	state.limit = ParseSteps(steps);
+	state.directory = directory;
+	state.target = target;
+	const char *kjfsProbe = std::getenv("PSPRECOMP_ORACLE_KJFS_PROBE");
+	if (kjfsProbe && std::strcmp(kjfsProbe, "1") != 0)
+		OracleFatal("PSPRECOMP_ORACLE_KJFS_PROBE must be 1 when set");
+	state.kjfsProbeEnabled = kjfsProbe != nullptr;
+	const char *kjfsEvents = std::getenv("PSPRECOMP_ORACLE_KJFS_EVENTS");
+	if (kjfsEvents && std::strcmp(kjfsEvents, "1") != 0)
+		OracleFatal("PSPRECOMP_ORACLE_KJFS_EVENTS must be 1 when set");
+	state.kjfsEventsEnabled = state.kjfsProbeEnabled || kjfsEvents != nullptr;
+	const char *eventsOnly = std::getenv("PSPRECOMP_ORACLE_EVENTS_ONLY");
+	if (eventsOnly && std::strcmp(eventsOnly, "1") != 0)
+		OracleFatal("PSPRECOMP_ORACLE_EVENTS_ONLY must be 1 when set");
+	state.eventsOnly = eventsOnly != nullptr;
+	if (state.eventsOnly && !state.kjfsEventsEnabled)
+		OracleFatal("events-only capture requires KJFS events");
+	state.enabled = true;
+}
+
+void WriteJSONString(FILE *stream, const char *value) {
+	std::fputc('"', stream);
+	for (const unsigned char *p = (const unsigned char *)value; *p; ++p) {
+		switch (*p) {
+		case '"':
+			std::fputs("\\\"", stream);
+			break;
+		case '\\':
+			std::fputs("\\\\", stream);
+			break;
+		case '\b':
+			std::fputs("\\b", stream);
+			break;
+		case '\f':
+			std::fputs("\\f", stream);
+			break;
+		case '\n':
+			std::fputs("\\n", stream);
+			break;
+		case '\r':
+			std::fputs("\\r", stream);
+			break;
+		case '\t':
+			std::fputs("\\t", stream);
+			break;
+		default:
+			if (*p < 0x20)
+				std::fprintf(stream, "\\u%04x", *p);
+			else
+				std::fputc(*p, stream);
+			break;
+		}
+	}
+	std::fputc('"', stream);
+}
+
+void WriteHexBytes(FILE *stream, u32 address, u32 size) {
+	for (u32 i = 0; i < size; ++i)
+		std::fprintf(stream, "%02x", Memory::Read_U8(address + i));
+}
+
+struct BlockJSONContext {
+	FILE *stream;
+	bool first = true;
+};
+
+void WriteBlockJSON(
+	u32 start,
+	u32 size,
+	bool taken,
+	const char *tag,
+	void *userdata) {
+	BlockJSONContext *context = (BlockJSONContext *)userdata;
+	if (!context->first)
+		std::fputc(',', context->stream);
+	std::fputs("\n      {\"start\":", context->stream);
+	std::fprintf(
+		context->stream,
+		"%u,\"size\":%u,\"taken\":%s,\"tag\":",
+		start,
+		size,
+		taken ? "true" : "false");
+	WriteJSONString(context->stream, tag ? tag : "");
+	std::fputc('}', context->stream);
+	context->first = false;
+}
+
+void WriteBlockList(FILE *stream, const BlockAllocator &allocator) {
+	BlockJSONContext context{stream};
+	allocator.IterateBlocks(WriteBlockJSON, &context);
+	if (!context.first)
+		std::fputc('\n', stream);
+}
+
+PSPThread *CurrentThread() {
+	u32 error = 0;
+	return kernelObjects.Get<PSPThread>(__KernelGetCurThread(), error);
+}
+
+void WriteStack(const PSPThread *thread) {
+	const u32 start = thread->currentStack.start;
+	const u32 size = thread->currentStack.end - start;
+	const u8 *data = Memory::GetPointerRange(start, size);
+	if (!data)
+		OracleFatal("current thread stack is not readable");
+	const std::string path = OutputPath("stack.bin");
+	FILE *stream = std::fopen(path.c_str(), "wb");
+	if (!stream)
+		OracleFatal("cannot create stack.bin");
+	if (std::fwrite(data, 1, size, stream) != size || std::fclose(stream) != 0)
+		OracleFatal("cannot write stack.bin");
+}
+
+void WriteThreadJSON(FILE *stream, SceUID uid, const PSPThread *thread) {
+	std::fputs("{\"uid\":", stream);
+	std::fprintf(stream, "%d,\"name\":", uid);
+	WriteJSONString(stream, thread->nt.name);
+	std::fprintf(
+		stream,
+		",\"entry\":%u,\"module_uid\":%d,\"attr\":%u,\"status\":%u,"
+		"\"initial_priority\":%d,\"current_priority\":%d,"
+		"\"stack_start\":%u,\"stack_size\":%u,\"gp\":%u}",
+		(u32)thread->nt.entrypoint,
+		thread->moduleId,
+		(u32)thread->nt.attr,
+		(u32)thread->nt.status,
+		(s32)thread->nt.initialPriority,
+		(s32)thread->nt.currentPriority,
+		thread->currentStack.start,
+		thread->currentStack.end - thread->currentStack.start,
+		(u32)thread->nt.gpreg);
+}
+
+void WriteModuleJSON(FILE *stream, SceUID uid, const PSPModule *module) {
+	char name[sizeof(module->nm.name) + 1]{};
+	std::memcpy(name, module->nm.name, sizeof(module->nm.name));
+	std::fputs("{\"uid\":", stream);
+	std::fprintf(stream, "%d,\"name\":", uid);
+	WriteJSONString(stream, name);
+	std::fprintf(
+		stream,
+		",\"status\":%u,\"attr\":%u,\"entry\":%u,\"gp\":%u,"
+		"\"text_addr\":%u,\"text_size\":%u,\"data_size\":%u,"
+		"\"bss_size\":%u,\"memory_block_addr\":%u,"
+		"\"memory_block_size\":%u,\"module_struct_addr\":%u,"
+		"\"start_priority\":%u,\"start_stack_size\":%u,"
+		"\"start_attr\":%u}",
+		(u32)module->nm.status,
+		(u32)module->nm.attribute,
+		(u32)module->nm.entry_addr,
+		(u32)module->nm.gp_value,
+		(u32)module->nm.text_addr,
+		(u32)module->nm.text_size,
+		(u32)module->nm.data_size,
+		(u32)module->nm.bss_size,
+		module->memoryBlockAddr,
+		module->memoryBlockSize,
+		module->modulePtr.ptr,
+		(u32)module->nm.module_start_thread_priority,
+		(u32)module->nm.module_start_thread_stacksize,
+		(u32)module->nm.module_start_thread_attr);
+}
+
+void WriteBootState(MIPSState *mips) {
+	PSPThread *thread = CurrentThread();
+	if (!thread)
+		OracleFatal("no current PSP thread at trace entry");
+	const u32 argLength = mips->r[MIPS_REG_A0];
+	const u32 argAddress = mips->r[MIPS_REG_A1];
+	if (argLength > 1024 * 1024)
+		OracleFatal("module argument exceeds one MiB");
+	if (argLength && !Memory::IsValidRange(argAddress, argLength))
+		OracleFatal("module argument range is invalid");
+
+	WriteStack(thread);
+	const std::string path = OutputPath("boot_state.json");
+	FILE *stream = std::fopen(path.c_str(), "wb");
+	if (!stream)
+		OracleFatal("cannot create boot_state.json");
+	std::fprintf(
+		stream,
+		"{\n  \"schema\": 1,\n  \"entry_pc\": %u,\n"
+		"  \"gp\": %u,\n  \"sp\": %u,\n  \"hi\": %u,\n"
+		"  \"lo\": %u,\n  \"fcr31\": %u,\n  \"fpcond\": %u,\n",
+		mips->pc,
+		mips->r[MIPS_REG_GP],
+		mips->r[MIPS_REG_SP],
+		mips->hi,
+		mips->lo,
+		mips->fcr31,
+		mips->fpcond);
+	std::fputs("  \"gpr\": [", stream);
+	for (int i = 0; i < 32; ++i)
+		std::fprintf(stream, "%s%u", i ? ", " : "", mips->r[i]);
+	std::fputs("],\n  \"fpr_bits\": [", stream);
+	for (int i = 0; i < 32; ++i)
+		std::fprintf(stream, "%s%u", i ? ", " : "", mips->fi[i]);
+	std::fputs("],\n  \"vfpu_bits\": [", stream);
+	for (int i = 0; i < 128; ++i)
+		std::fprintf(stream, "%s%u", i ? ", " : "", mips->vi[i]);
+	std::fputs("],\n  \"vfpu_control\": [", stream);
+	for (int i = 0; i < 16; ++i)
+		std::fprintf(stream, "%s%u", i ? ", " : "", mips->vfpuCtrl[i]);
+	std::fprintf(
+		stream,
+		"],\n  \"next_uid\": %d,\n  \"initial_ge_list_id\": %d,\n"
+		"  \"ram_size\": %u,\n  \"memory_pools\": {\n"
+		"    \"kernel\": [",
+		kernelObjects.GetNextUID(),
+		gpu ? gpu->GetNextListID() : 0,
+		Memory::g_MemorySize);
+	WriteBlockList(stream, kernelMemory);
+	std::fputs("    ],\n    \"user\": [", stream);
+	WriteBlockList(stream, userMemory);
+	std::fputs("    ],\n    \"volatile\": [", stream);
+	BlockAllocator *volatileMemory = BlockAllocatorFromID(5);
+	if (!volatileMemory)
+		OracleFatal("volatile memory allocator is unavailable");
+	WriteBlockList(stream, *volatileMemory);
+	std::fprintf(
+		stream,
+		"    ]\n  },\n  \"argument\": {\"length\": %u,"
+		" \"address\": %u, \"hex\": \"",
+		argLength,
+		argAddress);
+	WriteHexBytes(stream, argAddress, argLength);
+	std::fputs("\"},\n  \"current_thread\": ", stream);
+	WriteThreadJSON(stream, thread->GetUID(), thread);
+	std::fputs(",\n  \"modules\": [", stream);
+	bool first = true;
+	kernelObjects.Iterate<PSPModule>(
+		[&](SceUID uid, PSPModule *item) {
+			if (!first)
+				std::fputs(",", stream);
+			std::fputs("\n    ", stream);
+			WriteModuleJSON(stream, uid, item);
+			first = false;
+			return true;
+		});
+	std::fputs("\n  ],\n  \"threads\": [", stream);
+	first = true;
+	kernelObjects.Iterate<PSPThread>(
+		[&](SceUID uid, PSPThread *item) {
+			if (!first)
+				std::fputs(",", stream);
+			std::fputs("\n    ", stream);
+			WriteThreadJSON(stream, uid, item);
+			first = false;
+			return true;
+		});
+	std::fputs("\n  ],\n  \"stack_file\": \"stack.bin\"\n}\n", stream);
+	if (std::fclose(stream) != 0)
+		OracleFatal("cannot close boot_state.json");
+}
+
+void OpenTrace(MIPSState *mips) {
+	const std::string tracePath = OutputPath("cpu.trace");
+	const std::string eventsPath = OutputPath("events.jsonl");
+	state.trace = std::fopen(tracePath.c_str(), "wb");
+	state.events = std::fopen(eventsPath.c_str(), "wb");
+	if (!state.trace || !state.events)
+		OracleFatal("cannot create trace output files");
+	std::fprintf(
+		state.trace,
+		"# psp-recomp trace v1 target=%s oracle=ppsspp "
+		"start_pc=0x%08x steps=%llu\n",
+		state.target.c_str(),
+		state.startPC,
+		state.limit);
+	std::fprintf(
+		state.trace,
+		"# kernel next_uid=0x%x\n",
+		kernelObjects.GetNextUID());
+	std::fprintf(
+		state.trace,
+		"# ge next_list_id=%d\n",
+		gpu ? gpu->GetNextListID() : 0);
+	std::fprintf(state.trace, "# init pc=0x%08x", mips->pc);
+	for (int i = 1; i < 32; ++i)
+		std::fprintf(state.trace, " r%d=0x%08x", i, mips->r[i]);
+	std::fprintf(
+		state.trace,
+		" hi=0x%08x lo=0x%08x fcr31=0x%08x fpcond=0x%08x\n",
+		mips->hi,
+		mips->lo,
+		mips->fcr31,
+		mips->fpcond);
+	WriteBootState(mips);
+	std::fprintf(
+		state.events,
+		"{\"event\":\"trace_start\",\"step\":0,\"thread\":%d,"
+		"\"pc\":%u}\n",
+		__KernelGetCurThread(),
+		mips->pc);
+	std::fprintf(
+		stderr,
+		"PSP recomp oracle: started at 0x%08x for %llu steps\n",
+		mips->pc,
+		state.limit);
+}
+
+void Snapshot(MIPSState *mips, u32 pc, u32 op) {
+	std::memcpy(state.r, mips->r, sizeof(state.r));
+	std::memcpy(state.fi, mips->fi, sizeof(state.fi));
+	std::memcpy(state.vi, mips->vi, sizeof(state.vi));
+	state.hi = mips->hi;
+	state.lo = mips->lo;
+	state.fcr31 = mips->fcr31;
+	state.pc = pc;
+	state.op = op;
+	state.memAddress = 0;
+	state.memSize = 0;
+
+	const MIPSOpcode opcode(op);
+	const MIPSInfo info = MIPSGetInfo(opcode);
+	if ((info & OUT_MEM) != 0) {
+		const int rs = (op >> 21) & 0x1F;
+		const s32 offset = (info & IS_VFPU) != 0
+			? (s16)(op & 0xFFFC)
+			: (s16)(op & 0xFFFF);
+		state.memAddress = mips->r[rs] + offset;
+		state.memSize = MIPSGetMemoryAccessSize(opcode);
+		const u32 primary = op >> 26;
+		if (primary == 42 || primary == 46)
+			state.memAddress &= ~3u;
+	}
+}
+
+void WriteStep(MIPSState *mips) {
+	std::fprintf(
+		state.trace,
+		"%llu pc=0x%08x op=0x%08x",
+		state.step,
+		state.pc,
+		state.op);
+	for (int i = 1; i < 32; ++i) {
+		if (mips->r[i] != state.r[i])
+			std::fprintf(state.trace, " r%d=0x%08x", i, mips->r[i]);
+	}
+	if (mips->hi != state.hi)
+		std::fprintf(state.trace, " hi=0x%08x", mips->hi);
+	if (mips->lo != state.lo)
+		std::fprintf(state.trace, " lo=0x%08x", mips->lo);
+	for (int i = 0; i < 32; ++i) {
+		if (mips->fi[i] != state.fi[i])
+			std::fprintf(state.trace, " f%d=0x%08x", i, mips->fi[i]);
+	}
+	if (mips->fcr31 != state.fcr31)
+		std::fprintf(state.trace, " fcr31=0x%08x", mips->fcr31);
+	for (int i = 0; i < 128; ++i) {
+		if (mips->vi[i] != state.vi[i])
+			std::fprintf(state.trace, " v%d=0x%08x", i, mips->vi[i]);
+	}
+	if (state.memSize == 1) {
+		std::fprintf(
+			state.trace,
+			" m8[0x%08x]=0x%02x",
+			state.memAddress,
+			Memory::Read_U8(state.memAddress));
+	} else if (state.memSize == 2) {
+		std::fprintf(
+			state.trace,
+			" m16[0x%08x]=0x%04x",
+			state.memAddress,
+			Memory::Read_U16(state.memAddress));
+	} else if (state.memSize == 4) {
+		std::fprintf(
+			state.trace,
+			" m32[0x%08x]=0x%08x",
+			state.memAddress,
+			Memory::Read_U32(state.memAddress));
+	} else if (state.memSize == 8 || state.memSize == 16) {
+		for (int offset = 0; offset < state.memSize; offset += 4) {
+			std::fprintf(
+				state.trace,
+				" m32[0x%08x]=0x%08x",
+				state.memAddress + offset,
+				Memory::Read_U32(state.memAddress + offset));
+		}
+	}
+	std::fputc('\n', state.trace);
+}
+
+void Complete() {
+	const std::string donePath = OutputPath("trace.done");
+	if (std::fflush(state.trace) != 0 || std::fclose(state.trace) != 0)
+		OracleFatal("cannot finalize cpu.trace");
+	state.trace = nullptr;
+	if (std::fflush(state.events) != 0 || std::fclose(state.events) != 0)
+		OracleFatal("cannot finalize events.jsonl");
+	state.events = nullptr;
+	FILE *done = std::fopen(donePath.c_str(), "wb");
+	if (!done || std::fprintf(done, "%llu\n", state.limit) < 0 || std::fclose(done) != 0)
+		OracleFatal("cannot write trace.done");
+	std::fprintf(
+		stderr,
+		"PSP recomp oracle: completed %llu steps\n",
+		state.limit);
+	Core_Stop();
+}
